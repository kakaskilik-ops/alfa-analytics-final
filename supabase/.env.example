# Server secrets; configure using Supabase secrets management, never commit real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase Edge runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGIN=https://your-domain.example
# Explicit opt-in only after verifying provider terms and redistribution rights.
ENABLE_YAHOO_UNOFFICIAL=false
