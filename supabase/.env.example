# Server only. Never put real secrets in git or VITE_* variables.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the Edge runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGIN=https://alfammetal.ru,https://www.alfammetal.ru
# 0 blocks paid requests. Increase only after deciding to enable paid API use.
AI_DAILY_TOKEN_LIMIT=0
NEWS_AI_TRANSLATION=false
ENABLE_YAHOO_UNOFFICIAL=false
# Licensed quote adapters remain disabled until access and billing are approved.
ALLOW_LICENSED_QUOTE_REQUESTS=false
# QUOTE_<PROVIDER>_API_KEY= is configured only in Supabase Edge secrets when required.
