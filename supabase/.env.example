# Server only. Never put real secrets in git or VITE_* variables.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the Edge runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGIN=https://your-domain.example
# 0 blocks paid requests. Increase only after deciding to enable paid API use.
AI_DAILY_TOKEN_LIMIT=0
NEWS_AI_TRANSLATION=false
ENABLE_YAHOO_UNOFFICIAL=false
