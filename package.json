{
  "name": "alfa-analytics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-database.mjs",
    "test:server": "deno test --config supabase/deno.json --allow-env supabase/functions/_shared/providers_test.ts supabase/functions/_shared/stage2_test.ts supabase/functions/_shared/automation_test.ts supabase/functions/_shared/free_ai_test.ts",
    "test:browser": "playwright test",
    "deploy:plan": "node scripts/prepare-deployment.mjs",
    "deploy:supabase": "node scripts/deploy-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "fast-xml-parser": "^5.12.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@>=7": "^11.0.1",
    "glob@>=9": "^14.0.6"
  }
}
